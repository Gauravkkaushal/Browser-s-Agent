{
  "name": "browser-agent",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "python -m uvicorn server.main:app --host 127.0.0.1 --port 8787",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:py": "python -m pytest server/tests -q",
    "smoke": "python -m server.eval.run_smoke",
    "gates": "python scripts/check_gates.py",
    "generate:icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@huggingface/transformers": "^4.2.0",
    "antd": "^6.6.2",
    "jsqr": "^1.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "qrcode": "^1.5.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.0"
  }
}
