{
  "manifest_version": 3,
  "name": "NetraShield",
  "description": "Privacy-preserving browser vision agent that redacts sensitive page context before server reasoning.",
  "version": "0.1.0",
  "action": {
    "default_popup": "index.html",
    "default_title": "NetraShield"
  },
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": ["http://localhost:8787/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
