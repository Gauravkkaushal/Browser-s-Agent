{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Browser Agent - Real Computer-Use Agent",
  "description": "Closed-loop observe/reason/act/verify browser agent running inside your own Chrome profile.",
  "version": "2.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "index.html",
    "default_title": "Browser Agent"
  },
  "background": {
    "service_worker": "agent-background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "agent-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "webNavigation",
    "notifications",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "agent-content.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}