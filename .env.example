# ==== Browser Agent server config ====
PORT=8787
HOST=127.0.0.1

# Provider chain order (comma separated). First healthy provider wins.
# Ollama first: it answers on-device, with no data leaving the machine and no
# API cost. `ollama pull llama3.2` (text) and `ollama pull moondream` (vision,
# ~1.7GB) are enough to try it -- if Ollama isn't running, this rung fails in
# well under a second and falls straight through to Gemini/Groq/OpenRouter.
LLM_PROVIDER=ollama,gemini,groq,openrouter

# ---- OpenRouter (OpenAI-compatible). Multiple keys = automatic rotation on 429/401 ----
OPENROUTER_API_KEYS=sk-or-v1-...,sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PLANNER_MODELS=openai/gpt-4o-mini
OPENROUTER_REASONER_MODELS=openai/gpt-4o-mini

# ---- Groq (OpenAI-compatible) fallback ----
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Ladders, tried left to right. compound* have a 70k tokens/min window;
# the gpt-oss models only 8k, so they sit behind as backstops.
GROQ_PLANNER_MODELS=openai/gpt-oss-20b,groq/compound-mini
# gpt-oss models reason honestly from the observation. groq/compound is an
# agentic model that narrates browsing it never did, so it sits last and is
# only ever reached when the others are rate-limited.
GROQ_REASONER_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,groq/compound

# ---- Optional direct OpenAI / Gemini / Ollama ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=AIza... or AQ....
# Ladders: the newest flash models intermittently answer 503 'high demand',
# so a task steps down a rung instead of failing.
GEMINI_PLANNER_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# flash-lite answers a next-action step in ~1.6s; the thinking models take
# 9-24s for the same decision. Speed is the whole difference between an
# agent that feels alive and one that feels broken.
GEMINI_REASONER_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-2.5-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Small quantized vision-language model, used automatically whenever a step
# carries a screenshot. moondream (~1.7GB) is the lightest; llava/bakllava/
# minicpm-v also work if you want stronger grounding at more RAM.
OLLAMA_VISION_MODEL=moondream

# ---- On-device perception ----
# Try Chrome's built-in model (window.ai / Prompt API) before anything else.
# Fails fast and falls through when the API isn't available in this Chrome.
LOCAL_REASON_ENABLED=true
# Send the redacted screenshot to the reasoner so on-device vision (the
# Ollama rung above) actually grounds actions in the page's pixels, not just
# the DOM digest. Only applies on steps that already captured a screenshot.
VISION_REASONING_ENABLED=true
# The measured (not aspirational) size of a normal step's reasoner payload.
# Going over this doesn't block the step -- it emits PAYLOAD_BUDGET_EXCEEDED
# so an oversized page is visible in the cockpit/audit trail, not silent.
PAYLOAD_BUDGET_KB=50

# ---- Loop guards ----
MAX_STEPS=60
WALL_CLOCK_S=600
CONFIRM_TIMEOUT_S=120
LOGIN_TIMEOUT_S=300
SCREENSHOT_EVERY=5
