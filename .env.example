# ==== Browser Agent server config ====
PORT=8787
HOST=127.0.0.1

# Provider chain order (comma separated). First healthy provider wins.
# Groq first: the OpenRouter keys supplied were out of credits (402).
LLM_PROVIDER=groq,openrouter,ollama

# ---- OpenRouter (OpenAI-compatible). Multiple keys = automatic rotation on 429/401 ----
OPENROUTER_API_KEYS=sk-or-v1-...,sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PLANNER_MODEL=openai/gpt-4o-mini
OPENROUTER_REASONER_MODEL=openai/gpt-4o-mini

# ---- Groq (OpenAI-compatible) fallback ----
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_PLANNER_MODEL=openai/gpt-oss-20b
GROQ_REASONER_MODEL=openai/gpt-oss-120b

# ---- Optional direct OpenAI / Gemini / Ollama ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- Loop guards ----
MAX_STEPS=60
WALL_CLOCK_S=600
CONFIRM_TIMEOUT_S=120
LOGIN_TIMEOUT_S=300
SCREENSHOT_EVERY=5
